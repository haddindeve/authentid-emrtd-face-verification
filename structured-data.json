          "@type": "Question",
          "name": "What is an eMRTD?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An electronic machine-readable travel document - a passport or ID card with a chip holding issuer-signed biometric data."
          }
        },
        {
          "@type": "Question",
          "name": "Why read the chip instead of the photo page?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The printed page is what a forger controls. The chip is signed by the issuing authority and can be validated."
          }
        },
